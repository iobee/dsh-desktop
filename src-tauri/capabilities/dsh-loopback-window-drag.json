{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dsh-loopback-window-drag",
  "description": "Allow the local dsh page to drag and maximize its host window.",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "platforms": ["macOS"],
  "windows": ["main"],
  "permissions": [
    "allow-set-traffic-lights-visible",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
