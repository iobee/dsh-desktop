{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dsh-loopback-opener",
  "description": "Allow the local dsh page to open external links in the system default application.",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
