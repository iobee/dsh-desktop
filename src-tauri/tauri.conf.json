{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.7",
  "identifier": "com.iobee.dsh-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0b0d12",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "about",
        "create": false,
        "url": "about.html",
        "title": "关于 DSH Desktop",
        "width": 420,
        "height": 300,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#101216",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "updates",
        "create": false,
        "url": "updates.html",
        "title": "检查更新",
        "width": 460,
        "height": 370,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#101216",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/node": "node",
      "resources/npm": "npm",
      "resources/bootstrap-runtime": "bootstrap-runtime",
      "resources/runtime-manifest.json": "runtime-manifest.json",
      "resources/node-launcher.mjs": "node-launcher.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMTg5NTI5NDMxNDdCMTgKUldRWWV4UkRLWlVZbzBrNGFpZjJsSDNxaEJEUlZlbVJqT1FHQmQ1b3RiWFdBK21yVjA2ZTlxcTIK",
      "endpoints": [
        "https://github.com/iobee/dsh-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
