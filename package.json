{
  "name": "dsh-desktop",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "runtime:smoke": "node scripts/smoke-runtime.mjs",
    "desktop:dev": "npm run prepare:runtime && tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
